// Plain home-row keymap for braille (Perkins-style) input:
//   left half "asdf" (dots 7 3 2 1), right half "jkl;" (dots 4 5 6 8).
//
// asdf together -> backspace
// jkl; together  -> space
// fjkl; together -> space, held around the whole of the next chord (e.g.
//                   fjkl; then fj sends space+f+j)
//
// Bluetooth: press all 8 keys together, then one key:
//   a s d f j -> select profile 0 1 2 3 4
//   ;         -> clear current profile's bond
//   k l       -> cancel
//
// Behaviour is covered by the simulator tests in tests/braille. The original
// chording keymap can be regenerated with docs/gen_keymap.py.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define BLUETOOTH 1

// Give some time after the prefix to press the selection key.
&sl {
    release-after-ms = <3000>;
};

/ {
    behaviors {
        chord_hold: chord_hold {
            compatible = "zmk,behavior-chord-hold";
            #binding-cells = <1>;
        };
    };

    combos {
        compatible = "zmk,combos";
        bluetooth_prefix {
            timeout-ms = <150>;
            key-positions = <0 1 2 3 4 5 6 7>;
            layers = <DEFAULT>;
            bindings = <&sl BLUETOOTH>;
        };
        backspace {
            timeout-ms = <150>;
            key-positions = <0 1 2 3>;
            layers = <DEFAULT>;
            bindings = <&kp BSPC>;
        };
        space {
            timeout-ms = <150>;
            key-positions = <4 5 6 7>;
            layers = <DEFAULT>;
            bindings = <&kp SPACE>;
        };
        held_space {
            timeout-ms = <150>;
            key-positions = <3 4 5 6 7>;
            layers = <DEFAULT>;
            bindings = <&chord_hold SPACE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp A  &kp S  &kp D  &kp F
                &kp J  &kp K  &kp L  &kp SEMI
            >;
        };
        bluetooth_layer {
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
                &bt BT_SEL 4  &none         &none         &bt BT_CLR
            >;
        };
    };
};
